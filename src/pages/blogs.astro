
---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { blogs } from "../data/blogsData.js";
---

<Layout title="All Blogs | Syslatech">
  <section class="blogs-section all-blogs-section">
    <div class="blogs-container">
      <div class="blogs-heading">
        <span class="blogs-eyebrow">SYSLATECH INSIGHTS</span>

        <h2>
          Explore All
          <span>Blogs</span>
        </h2>

        <p>
          Discover insights on software testing, automation,
          quality engineering, and emerging technologies.
        </p>
      </div>

      <div class="blog-grid">
        {blogs.map((blog) => (
          <article class="blog-card">
            <a
              href={blog.href}
              class="blog-image"
              aria-label={blog.title}
            >
              <Image
                src={blog.image}
                alt={blog.alt}
                loading="lazy"
              />
            </a>

            <div class="blog-content">
              <span class="blog-category">{blog.category}</span>

              <h3 class="blog-card-title">{blog.title}</h3>

              <p class="blog-card-para">{blog.description}</p>

              <a href={blog.href} class="read-more-btn">
                Read More
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="blogs-footer">
        <a href="/" class="view-all-blogs">
          ← Back to Home
        </a>
      </div>
    </div>
  </section>
</Layout>
