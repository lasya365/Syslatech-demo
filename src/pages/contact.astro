---
import { withBase } from "../utils/withBase.js";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact Us | Syslatech"
  description="Contact Syslatech to explore opportunities and discuss your requirements."
>
  <main class="flex min-h-[500px] items-center justify-center bg-page px-4 py-8 text-body sm:px-6 sm:py-14">
    <section
  class="grid w-full max-w-[900px] grid-cols-1 content-center gap-x-12 rounded-xl border border-brand-border bg-surface p-5 sm:p-9"
  id="contact-form-section"
  aria-labelledby="contact-heading"
>
      <h1
        id="contact-heading"
        class="col-span-full mb-3 text-2xl font-extrabold leading-tight text-heading sm:text-[28px]"
      >
        Send Us A Message
      </h1>

      <p class="col-span-full mb-6 text-sm leading-7 text-muted">
        Let's connect and explore the endless opportunities to thrive
        in the digital world together!
      </p>

      <form
        id="contact-form"
        class="flex min-w-0 flex-col gap-2"
        novalidate
      >
        <label
          for="contact-name"
          class="mt-1 block text-[13px] font-semibold text-body"
        >
          Name *
        </label>

        <input
          id="contact-name"
          name="fullName"
          type="text"
          placeholder="Enter your Name"
          autocomplete="name"
          required
          class="w-full min-w-0 rounded border border-brand-border bg-surface px-3 py-3 text-[13px] text-heading outline-none transition focus:border-brand-blue focus:ring-2 focus:ring-brand-tint"
        />

        <span
          class="text-xs text-red-700"
          id="name-error"
        ></span>

        <label
          for="contact-phone"
          class="mt-1 block text-[13px] font-semibold text-body"
        >
          Mobile Number *
        </label>

        <div class="grid grid-cols-[110px_minmax(0,1fr)] gap-2">
          <select
            id="country-code"
            name="countryCode"
            aria-label="Country calling code"
            required
            class="w-full min-w-0 rounded border border-brand-border bg-surface px-3 py-3 text-[13px] text-heading outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-tint"
          >
            <option value="">Loading country codes...</option>
          </select>

          <input
            id="contact-phone"
            name="phone"
            type="tel"
            placeholder="Enter your mobile number"
            autocomplete="tel-national"
            inputmode="numeric"
            required
            class="w-full min-w-0 rounded border border-brand-border bg-surface px-3 py-3 text-[13px] text-heading outline-none transition focus:border-brand-blue focus:ring-2 focus:ring-brand-tint"
          />
        </div>

        <span
          class="text-xs text-red-700"
          id="phone-error"
        ></span>

        <label
          for="contact-email"
          class="mt-1 block text-[13px] font-semibold text-body"
        >
          Email Address *
        </label>

        <input
          id="contact-email"
          name="email"
          type="email"
          placeholder="Enter your Email"
          autocomplete="email"
          required
          class="w-full min-w-0 rounded border border-brand-border bg-surface px-3 py-3 text-[13px] text-heading outline-none transition focus:border-brand-blue focus:ring-2 focus:ring-brand-tint"
        />

        <span
          class="text-xs text-red-700"
          id="email-error"
        ></span>

        <label
          for="contact-message"
          class="mt-1 block text-[13px] font-semibold text-body"
        >
          Message
        </label>

        <textarea
          id="contact-message"
          name="message"
          placeholder="Send Us A Message"
          maxlength="180"
          rows="4"
          class="w-full min-w-0 resize-y rounded border border-brand-border bg-surface px-3 py-3 text-[13px] leading-relaxed text-heading outline-none transition focus:border-brand-blue focus:ring-2 focus:ring-brand-tint"
        ></textarea>

        <div class="text-right text-xs text-muted">
          <span id="message-count">0</span> / 180
        </div>

        <p
          id="contact-status"
          class="my-1 text-[13px] leading-relaxed"
          role="status"
          hidden
        ></p>

        <button
          type="submit"
          class="mt-3 self-start rounded-md bg-brand-navy px-5 py-3 text-[13px] font-bold text-white transition-colors hover:bg-brand-blue focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-blue"
        >
          Send Message
        </button>
      </form>
    </section>
  </main>
</Layout>

<script is:inline src={withBase("/scripts/contact.js")}></script>