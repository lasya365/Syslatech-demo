
---
import Layout from "../layouts/Layout.astro";
import "../styles/footer.css";
---

<Layout
  title="Contact Us | Syslatech"
  description="Contact Syslatech to explore opportunities and discuss your requirements."
>
  <main class="contact-page">
    <section class="contact-form-section" id="contact-form-section">
      <h1>Send Us A Message</h1>

      <p class="contact-intro">
        Let's connect and explore the endless opportunities to thrive
        in the digital world together!
      </p>

      <form
        id="contact-form"
        class="contact-form"
        onsubmit="return window.submitContactForm(event, this)"
        novalidate
      >
        <label for="contact-name">Name *</label>
        <input
          id="contact-name"
          name="fullName"
          type="text"
          placeholder="Enter your Name"
          autocomplete="name"
          required
          oninput="window.validateContactField(this)"
        />
        <span class="contact-error" id="name-error"></span>

        <label for="contact-phone">Mobile Number *</label>

        <div class="phone-row">
          <select
            id="country-code"
            name="countryCode"
            aria-label="Country calling code"
            required
            onchange="window.clearContactMessages(this.form)"
          >
            <option value="">Loading country codes...</option>
          </select>

          <input
            id="contact-phone"
            name="phone"
            type="tel"
            placeholder="Enter your mobile number"
            autocomplete="tel-national"
            inputmode="numeric"
            required
            oninput="window.validateContactField(this)"
          />
        </div>
        <span class="contact-error" id="phone-error"></span>

        <label for="contact-email">Email Address *</label>
        <input
          id="contact-email"
          name="email"
          type="email"
          placeholder="Enter your Email"
          autocomplete="email"
          required
          oninput="window.validateContactField(this)"
        />
        <span class="contact-error" id="email-error"></span>

        <label for="contact-message">Message</label>
        <textarea
          id="contact-message"
          name="message"
          placeholder="Send Us A Message"
          maxlength="180"
          rows="4"
          oninput="window.updateMessageCount(this)"
        ></textarea>

        <div class="message-counter">
          <span id="message-count">0</span> / 180
        </div>

        <p
          id="contact-status"
          class="contact-status"
          role="status"
          hidden
        ></p>

        <button type="submit">Send Message</button>
      </form>
    </section>
  </main>
</Layout>

<script is:inline src="/scripts/contact.js"></script>

<style>
  .contact-page {
    box-sizing: border-box;
    min-height: 500px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 60px 24px;
    background: #ffffff;
    color: #172033;
    font-family: "DM Sans", sans-serif;
  }

  .contact-page .contact-form-section {
    box-sizing: border-box;
    width: min(100%, 900px);
    padding: 36px;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    column-gap: 48px;
    align-content: center;
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 12px 35px rgb(0 0 0 / 15%);
  }

  .contact-page .contact-form-section h1 {
    grid-column: 1 / -1;
    margin: 0 0 12px;
    color: #172033;
    font-size: 28px;
    line-height: 1.3;
  }

  .contact-page .contact-intro {
    grid-column: 1 / -1;
    margin: 0 0 24px;
    color: #64748b;
    font-size: 14px;
    line-height: 1.7;
  }

  .contact-page .contact-form {
    grid-column: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .contact-page .contact-form label {
    display: block;
    margin-top: 5px;
    color: #334155;
    font-size: 13px;
    font-weight: 600;
  }

  .contact-page .contact-form input,
  .contact-page .contact-form select,
  .contact-page .contact-form textarea {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    padding: 11px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    background: #ffffff;
    color: #172033;
    font-family: inherit;
    font-size: 13px;
  }

  .contact-page .contact-form input:focus,
  .contact-page .contact-form select:focus,
  .contact-page .contact-form textarea:focus {
    outline: 2px solid #93c5fd;
    border-color: #2563eb;
  }

  .contact-page .phone-row {
    display: grid;
    grid-template-columns: minmax(100px, 0.4fr) minmax(0, 1.6fr);
    gap: 8px;
  }

  .contact-page .contact-form textarea {
    resize: vertical;
    line-height: 1.5;
  }

  .contact-page .contact-error {
    color: #b91c1c;
    font-size: 12px;
  }

  .contact-page .message-counter {
    color: #64748b;
    font-size: 12px;
    text-align: right;
  }

  .contact-page .contact-status {
    margin: 4px 0;
    font-size: 13px;
    line-height: 1.5;
  }

  .contact-page .contact-status[data-status="error"] {
    color: #b91c1c;
  }

  .contact-page .contact-status[data-status="success"] {
    color: #15803d;
  }

  .contact-page .contact-form button {
    align-self: flex-start;
    margin-top: 12px;
    padding: 12px 20px;
    border: 0;
    border-radius: 5px;
    background: #19212c;
    color: #ffffff;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .contact-page .contact-form button:hover {
    background: #2563eb;
  }

  @media (max-width: 650px) {
    .contact-page {
      padding: 32px 16px;
    }

    .contact-page .contact-form-section {
      grid-template-columns: minmax(0, 1fr);
      padding: 24px 18px;
    }

    .contact-page .contact-form-section h1,
    .contact-page .contact-intro,
    .contact-page .contact-form {
      grid-column: 1;
    }

    .contact-page .contact-form-section h1 {
      font-size: 24px;
    }
  }
</style>
