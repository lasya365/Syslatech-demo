
---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About Us | SyslaTech"
  description="Learn about SyslaTech and our commitment to quality engineering."
>
  <main class="mx-auto w-full max-w-site px-5 py-16 sm:px-8 sm:py-20 lg:px-10">
    <section class="rounded-2xl border border-brand-border bg-surface px-6 py-10 sm:px-10 sm:py-14 lg:px-16">
      <p class="mb-4 text-sm font-bold uppercase tracking-[0.18em] text-brand-blue">
        About Us
      </p>

      <h1 class="max-w-3xl text-3xl font-extrabold leading-tight text-heading sm:text-4xl lg:text-5xl">
        Quality Engineering for a Smarter Digital Future
      </h1>

      <p class="mt-6 max-w-3xl text-base leading-8 text-body sm:text-lg">
        At SyslaTech, we focus on helping businesses build reliable digital
        experiences through quality engineering and software testing.
      </p>

      <h2 class="mt-10 text-xl font-bold text-heading sm:text-2xl">
        Our Mission
      </h2>

      <p class="mt-3 max-w-3xl leading-8 text-body">
        Our mission is to support better software quality by identifying issues
        early, improving reliability, and helping deliver seamless user experiences.
      </p>

      <a
        href="/contact/"
        class="mt-8 inline-flex items-center rounded-lg bg-brand-blue px-7 py-3.5 text-sm font-bold text-white transition-colors hover:bg-brand-hover"
      >
        Contact Us <span class="ml-2" aria-hidden="true">→</span>
      </a>
    </section>
  </main>
</Layout>
