---
import ctaData from "../data/ctaData.js";

interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
  showArrow?: boolean;
}

const {
  title = ctaData.title,
  description = ctaData.description,
  buttonText = ctaData.buttonText,
  buttonHref = ctaData.buttonHref,
  showArrow = ctaData.showArrow,
} = Astro.props;
---

<section
  class="relative isolate overflow-hidden bg-page px-5 py-13 text-center text-body sm:px-6 sm:py-[60px] md:py-[72px]"
  aria-labelledby="cta-heading"
>
  <!-- Decorative blue glow -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-[-190px] -z-10 h-[420px] w-[min(600px,100%)] -translate-x-1/2 rounded-[50%] bg-[radial-gradient(ellipse_at_center,_rgb(7_153_245_/_12%)_0%,_rgb(7_153_245_/_5%)_42%,_transparent_72%)]"
  ></div>

  <div class="relative z-10 mx-auto w-full max-w-[1100px] font-sans">
    <h2
      id="cta-heading"
      class="mx-auto w-full text-heading text-[clamp(1.8rem,3.2vw,2.8rem)] leading-[1.25] font-extrabold tracking-[-0.035em] max-sm:leading-[1.3]"
    >
      {title}
    </h2>

    <p
      class="mx-auto mt-4 mb-7 max-w-[690px] text-base leading-[1.75] font-normal text-body sm:mt-[18px] sm:mb-[26px] sm:text-[1.08rem] sm:leading-[1.7] max-sm:mt-4 max-sm:mb-6 max-sm:text-[0.96rem]"
    >
      {description}
    </p>

    <a
      href={buttonHref}
      class="group inline-flex min-h-11 items-center justify-center gap-[9px] rounded-md border border-brand-blue bg-brand-blue px-[21px] py-[10px] text-[0.95rem] leading-[1.3] font-semibold text-white no-underline shadow-[0_4px_12px_rgb(7_153_245_/_12%)] transition-[background-color,border-color,box-shadow,transform] duration-200 ease-in-out hover:-translate-y-0.5 hover:border-brand-hover hover:bg-brand-hover hover:shadow-[0_7px_18px_rgb(7_153_245_/_24%)] focus-visible:outline-3 focus-visible:outline-offset-[5px] focus-visible:outline-brand-blue motion-reduce:transition-none motion-reduce:hover:transform-none max-sm:min-h-[42px] max-sm:px-[19px] max-sm:text-[0.92rem]"
    >
      <span>{buttonText}</span>

      {showArrow ? (
        <svg
          class="h-[17px] w-[17px] shrink-0 transition-transform duration-200 group-hover:translate-x-[3px] motion-reduce:transition-none"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      ) : null}
    </a>
  </div>
</section>