---
import "../styles/cta-section.css";
---

<section class="cta-section" aria-labelledby="cta-heading">
  <div class="cta-content">
    <h2 id="cta-heading" class="cta-title">
      Ready to Improve Software Quality?
    </h2>

    <p class="cta-description">
      Talk to our QA experts and see how we can support your testing needs.
      Get customized solutions tailored to your business requirements.
    </p>

    <a
      class="cta-button"
      href="https://syslatech.com/contact.html"
    >
      <span>Get Started</span>
      <svg
        class="cta-arrow"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    </a>
  </div>
</section>