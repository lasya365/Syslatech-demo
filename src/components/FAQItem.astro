---
interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;

---

<details
  name="syslatech-faq"
  class="group rounded-[15px] border border-[#D5E1EE] bg-white transition-colors duration-300 open:border-[#168BFA] open:ring-1 open:ring-[#168BFA]/40"
>
  <summary
    class="flex min-h-[68px] cursor-pointer list-none items-center justify-between gap-4 rounded-[15px] px-5 py-4 text-[15px] leading-6 font-bold text-[#0B1B31] transition-colors duration-200 hover:text-[#0878D1] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#168BFA] sm:px-[22px] sm:text-base [&::-webkit-details-marker]:hidden"
  >
    <span class="min-w-0 flex-1">
      {question}
    </span>

    <!-- Icon container -->
    <span
      class="relative grid size-7 shrink-0 place-items-center rounded-full bg-[#E2F0FF] text-[#1676D2] transition-colors duration-300 group-open:bg-[#1676D2] group-open:text-white"
      aria-hidden="true"
    >
      <!-- Plus icon -->
      <span
        class="absolute text-xl leading-none transition-[transform,opacity] duration-300 ease-in-out group-open:rotate-90 group-open:scale-75 group-open:opacity-0 motion-reduce:transition-none"
      >
        +
      </span>

      <!-- Cross icon -->
      <span
        class="absolute rotate-[-90deg] scale-75 text-lg leading-none opacity-0 transition-[transform,opacity] duration-300 ease-in-out group-open:rotate-0 group-open:scale-100 group-open:opacity-100 motion-reduce:transition-none"
      >
        ×
      </span>
    </span>
  </summary>

  <div
     class="faq-answer-grid grid grid-rows-[0fr] group-open:grid-rows-[1fr]"
  >
    <div class="min-h-0 overflow-hidden">
      <div class="px-5 pb-5 pt-1 sm:px-[22px] sm:pb-6">
        <p class="text-sm leading-7 text-[#536780] sm:text-[15px]">
          {answer}
        </p>
      </div>
    </div>
  </div>
</details>

<script>
  import "../scripts/faq-transition.js";
</script>