
---
import WhyChooseUsItem from "./WhyChooseUsItem.astro";
import "../styles/why-choose-us.css";
---

<section class="why-section" aria-labelledby="why-heading">
  <div class="why-section__container">

    <h2 id="why-heading" class="why-section__heading">
      WHY?
    </h2>

    <div class="why-section__list">

      <WhyChooseUsItem
        icon="fa-solid fa-brain"
        title="Experts in AI Tool"
        description="We utilize cutting-edge AI-powered testing tools to enhance test coverage, automate repetitive tasks, and identify defects early."
      />

      <WhyChooseUsItem
        icon="fa-solid fa-industry"
        title="Industries We Serve"
        description="We support IT, fintech, healthcare, e-commerce, and enterprise solutions with industry-specific expertise."
      />

      <WhyChooseUsItem
        icon="fa-solid fa-lightbulb"
        title="Customised Solutions"
        description="Our testing approaches are tailored to your business needs, technology stack, and project goals."
      />

      <WhyChooseUsItem
        icon="fa-solid fa-people-group"
        title="End-to-End Quality Delivery"
        description="From validation to final sign-off, our QA teams ensure your product is reliable and ready for release."
      />

    </div>
  </div>
</section>
