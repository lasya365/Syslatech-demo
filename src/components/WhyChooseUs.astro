---
import WhyChooseUsItem from "./WhyChooseUsItem.astro";
import { whyChooseUsData } from "../data/whyChooseUsData";
---

<section
  class="bg-[linear-gradient(110deg,#399fc4,#32c59c)] px-5 pt-20 pb-[60px] text-white max-md:px-4 max-md:pt-[65px] max-md:pb-10"
  aria-labelledby="why-heading"
>
  <div
    class="relative mx-auto max-w-[980px] rounded-[14px] border border-white/30 bg-white/[0.04] px-12 pt-[42px] pb-[30px] shadow-[0_15px_35px_rgba(0,0,0,0.08)] max-md:px-5 max-md:pt-[35px] max-md:pb-5 max-[420px]:px-[14px]"
  >
    <h2
      id="why-heading"
      class="absolute -top-[23px] left-1/2 z-10 m-0 -translate-x-1/2 whitespace-nowrap bg-[#35b3b0] px-7 py-[5px] text-center font-sans text-[30px] leading-[1.3] font-extrabold tracking-[5px] text-white max-md:-top-5 max-md:text-[26px] max-md:tracking-[4px] max-[420px]:px-5 max-[420px]:text-[23px] max-[420px]:tracking-[3px]"
    >
      WHY?
      <span
        aria-hidden="true"
        class="mx-auto mt-[5px] block h-[3px] w-12 rounded-full bg-white"
      ></span>
    </h2>

    <div class="flex flex-col">
      {whyChooseUsData.map((item) => (
        <WhyChooseUsItem
          icon={item.icon}
          title={item.title}
          description={item.description}
        />
      ))}
    </div>
  </div>
</section>
