---
import { withBase } from "../utils/withBase.js";
import { faqs } from "../data/faqs.js";
import FAQItem from "./FAQItem.astro";
---

<section
  class="relative border-t border-brand-border bg-page px-5 py-12 font-sans text-body sm:px-8 sm:py-14 lg:px-10 lg:py-16"
  aria-labelledby="faq-heading"
>
  <div
    class="mx-auto grid w-full max-w-[1180px] grid-cols-1 items-center gap-9 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:gap-12"
  >
    <!-- Left: Image and contact card -->
    <div
      class="relative isolate mx-auto flex min-h-[360px] w-full max-w-[400px] flex-col overflow-hidden rounded-[22px] border border-brand-border bg-brand-navy sm:min-h-[400px] lg:min-h-[440px]"
    >
      <!-- Dedicated image area -->
      <div class="relative min-h-0 flex-1 overflow-hidden bg-brand-navy">
        <img
          class="absolute inset-0 h-full w-full object-contain object-center transition-transform duration-500 hover:scale-[1.02] motion-reduce:transition-none"
          src={withBase("/faq-image.jpg")}
          alt="Glowing digital question mark on a computer screen"
          loading="lazy"
          decoding="async"
        />

        <!-- Subtle fade at the bottom of the image -->
        <div
          class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-brand-navy/70 to-transparent"
          aria-hidden="true"
        ></div>
      </div>

      <!-- Contact card below the image -->
      <div class="shrink-0 bg-brand-navy px-4 py-4 sm:px-5 sm:py-5">
        <h3
          class="mb-3 font-sans text-base font-extrabold tracking-tight text-white sm:text-lg"
        >
          Still have questions?
        </h3>

        <a
          href={withBase("/contact")}
          class="flex min-h-[46px] w-full items-center justify-center gap-3 rounded-full border border-brand-border bg-surface px-5 py-3 font-sans text-sm font-bold text-heading transition-colors duration-200 hover:bg-surface-hover focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-blue sm:min-h-[48px] sm:text-base"
        >
          <span>Contact Us</span>

          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Right: FAQ heading and questions -->
    <div class="min-w-0 font-sans">
      <!-- Section label and heading -->
      <div class="mb-6 sm:mb-7">
        <p
          class="mb-3 flex items-center gap-3 font-sans text-[11px] font-extrabold uppercase tracking-[0.18em] text-brand-hover"
        >
          <span
            class="h-[2px] w-5 shrink-0 bg-brand-blue"
            aria-hidden="true"
          ></span>
          FAQ
        </p>

        <h2
          id="faq-heading"
          class="font-sans text-3xl leading-[1.12] font-extrabold tracking-[-0.045em] text-heading sm:text-4xl lg:text-[40px] xl:text-[44px]"
        >
          Frequently asked questions
        </h2>
      </div>

      <!-- Reusable FAQ items -->
      <div class="flex flex-col gap-3">
        {faqs.map((faq) => (
          <FAQItem
            question={faq.question}
            answer={faq.answer}
          />
        ))}
      </div>
    </div>
  </div>
</section>