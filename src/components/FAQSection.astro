---
import "../styles/faq-section.css";
import { faqs } from "../data/faqs.js";
import FAQItem from "./FAQItem.astro";
---

<section class="faq-section" aria-labelledby="faq-heading">
  <div class="faq-container">
    <h2 id="faq-heading" class="faq-title">
      Frequently Asked Questions
    </h2>

    <div class="faq-layout">
      <div class="faq-image-wrapper">
        <img
          class="faq-image"
          src="/faq-image.jpg"
          alt="Glowing digital question mark on a computer screen"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="faq-content">
        <div class="faq-list">
          {faqs.map((faq) => (
            <FAQItem
              question={faq.question}
              answer={faq.answer}
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>