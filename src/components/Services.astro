
---
const serviceGroups = [
  {
    title: "AI Services",
    services: [
      "Intelligent Test Case Generation",
      "Quality Test Scripts",
      "Natural Language Test Authoring",
      "AI-Powered Framework Development",
      "Adaptive Test Maintenance",
      "Supports All Platforms",
      "Multi-Source Support",
      "Automate Without Requirements",
      "AI-Powered Test Optimisation",
    ],
  },
  {
    title: "QA – Manual",
    services: [
      "Functional Testing",
      "Integration Testing",
      "Regression Testing",
      "Exploratory Testing",
      "Smoke Testing",
      "End-to-End Testing",
      "UAT Testing",
    ],
  },
  {
    title: "QA – Automation",
    services: [
      "UI Test Automation",
      "Functional Test Automation",
      "Regression Automation",
      "API Automation",
      "Mobile Automation",
      "Desktop Automation",
    ],
  },
];

const serviceCards = [
  {
    title: "AI Services",
    description:
      "Intelligent testing solutions that help teams generate tests, maintain scripts, and optimise quality workflows.",
    features: [
      "Natural language authoring",
      "Self-healing tests",
      "Test optimisation",
    ],
  },
  {
    title: "QA – Manual",
    description:
      "Human-led testing to identify defects, validate requirements, and deliver a reliable user experience.",
    features: [
      "Exploratory testing",
      "Smoke testing",
      "User acceptance testing",
    ],
  },
  {
    title: "QA – Automation",
    description:
      "Reusable automated test suites that help teams validate applications across platforms and releases.",
    features: [
      "UI and API testing",
      "Mobile testing",
      "Desktop testing",
    ],
  },
];
---

<section
  id="services"
  aria-labelledby="services-heading"
  class="relative scroll-mt-24 overflow-hidden bg-page px-5 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28"
>
  <!-- Soft brand background accents -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -left-40 top-20 h-80 w-80 rounded-full bg-brand-blue/10 blur-3xl"
  ></div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-40 bottom-20 h-96 w-96 rounded-full bg-surface-blue/70 blur-3xl"
  ></div>

  <div class="relative mx-auto max-w-site">
    <!-- Section heading -->
    <div class="mx-auto max-w-3xl text-center">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-brand-border bg-brand-tint px-4 py-2 text-xs font-bold uppercase tracking-[0.2em] text-brand-blue"
      >
        <span class="h-2 w-2 rounded-full bg-brand-blue"></span>
        Our Services
      </span>

      <h2
        id="services-heading"
        class="mt-6 text-3xl font-extrabold leading-tight tracking-tight text-heading sm:text-4xl lg:text-5xl"
      >
        AI services. Manual QA.
        <span class="bg-gradient-to-r from-brand-blue to-brand-hover bg-clip-text text-transparent">
          Automation.
        </span>
      </h2>

      <p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-body sm:text-base">
        Specialised software testing services designed to improve quality,
        simplify workflows, and support your product release cycle.
      </p>
    </div>

    <!-- Service categories -->
    <div class="mt-14 space-y-8 sm:mt-16">
      {serviceGroups.map((group) => (
        <div class="rounded-2xl border border-brand-border bg-surface p-5 shadow-sm transition duration-300 hover:shadow-md sm:p-7">
          <div class="mb-5 flex items-center gap-3">
            <h3 class="text-lg font-bold text-heading sm:text-xl">
              {group.title}
            </h3>

            <span class="ml-auto rounded-full bg-surface-blue px-3 py-1 text-xs font-semibold text-brand-hover">
              {group.services.length} services
            </span>
          </div>

          <div class="flex flex-wrap gap-3">
            {group.services.map((service) => (
              <span class="inline-flex items-center gap-2 rounded-full border border-brand-border bg-page px-4 py-3 text-xs font-medium text-body transition duration-300 hover:border-brand-blue hover:bg-surface-hover hover:text-brand-hover sm:text-sm">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-brand-blue"></span>
                {service}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Service summary cards -->
    <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3 lg:mt-16">
      {serviceCards.map((card) => (
        <article class="group relative overflow-hidden rounded-2xl border border-brand-border bg-surface p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-brand-blue/50 hover:shadow-xl hover:shadow-brand-blue/10 sm:p-7">
          <div class="absolute right-0 top-0 h-28 w-28 rounded-full bg-brand-tint opacity-60 blur-2xl transition duration-300 group-hover:opacity-100"></div>

          <div class="relative">

            <h3 class="mt-6 text-xl font-bold text-heading">
              {card.title}
            </h3>

            <p class="mt-3 min-h-20 text-sm leading-7 text-body">
              {card.description}
            </p>

            <ul class="mt-5 space-y-3 border-t border-brand-border pt-5">
              {card.features.map((feature) => (
                <li class="flex items-center gap-3 text-sm text-body">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-tint text-xs font-bold text-brand-blue">
                    ✓
                  </span>
                  {feature}
                </li>
              ))}
            </ul>

            <div class="mt-6 h-1 w-12 rounded-full bg-gradient-to-r from-brand-blue to-brand-hover transition-all duration-300 group-hover:w-24"></div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
