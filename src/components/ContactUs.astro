
---
import { Icon } from "astro-icon/components";
---

<div class="footer-column footer-contact-us min-w-0 font-sans">
  <h2 class="mb-5 mt-1 text-[17px] font-bold leading-6 text-heading md:mb-[25px]">
    Contact Us
    <span class="mt-3 block h-[3px] w-9 rounded-full bg-brand-blue"></span>
  </h2>

  <ul class="footer-contact m-0 flex list-none flex-col gap-3 p-0 md:gap-[14px]">
    <li class="flex items-center gap-3">
      <Icon
        name="lucide:map-pin"
        class="contact-icon h-5 w-5 shrink-0 text-body"
        aria-hidden="true"
      />
      <div class="contact-details min-w-0">
        <p class="m-0 text-sm leading-[1.7] text-body">
          Bangalore, Karnataka, India
        </p>
      </div>
    </li>

    <li class="flex items-center gap-3">
      <Icon
        name="lucide:mail"
        class="contact-icon h-5 w-5 shrink-0 text-body"
        aria-hidden="true"
      />
      <div class="contact-details min-w-0">
        <a
          href="mailto:chandu@syslatech.com"
          class="text-sm leading-[1.7] text-body no-underline transition-colors duration-200 hover:text-brand-blue"
        >
          chandu@syslatech.com
        </a>
      </div>
    </li>

    <li class="flex items-center gap-3">
      <Icon
        name="lucide:phone"
        class="contact-icon h-5 w-5 shrink-0 text-body"
        aria-hidden="true"
      />
      <div class="contact-details min-w-0">
        <a
          href="tel:+919986055536"
          class="text-sm leading-[1.7] text-body no-underline transition-colors duration-200 hover:text-brand-blue"
        >
          +91 9986055536
        </a>
      </div>
    </li>
  </ul>
</div>
