
---
---

<div class="footer-column footer-form-column">
  <h2>CONTACT US</h2>

  <form class="footer-form" action="/contact/" method="get">
    <label class="visually-hidden" for="footer-name">
      Full Name
    </label>
    <input
      id="footer-name"
      type="text"
      name="name"
      placeholder="Full Name"
      autocomplete="name"
      required
    />

    <div class="footer-phone-row">
      <label class="visually-hidden" for="footer-phone">
        Phone number
      </label>
      <input
        id="footer-phone"
        type="tel"
        name="phone"
        placeholder="+91 IN"
        autocomplete="tel"
        required
      />
      <span class="footer-phone-placeholder">
        Enter your phone number
      </span>
    </div>

    <label class="visually-hidden" for="footer-email">
      Email address
    </label>
    <input
      id="footer-email"
      type="email"
      name="email"
      placeholder="Your email here"
      autocomplete="email"
      required
    />

    <button type="submit">
      Submit
    </button>
  </form>
</div>
