---
import Layout from "../layouts/Layout.astro";
import SolutionHero from "./solution-sections/SolutionHero.astro";
import ChallengeSolution from "./solution-sections/ChallengeSolution.astro";
import WhatWeTest from "./solution-sections/WhatWeTest.astro";
import ApproachImpact from "./solution-sections/ApproachImpact.astro";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  subtitle: string;
  description: string;
  heroImage?: ImageMetadata;
  cta: {
    label: string;
    href: string;
  };
  challenge: {
    title: string;
    description: string;
    image?: ImageMetadata;
    imageAlt: string;
  };
  solution: {
    title: string;
    description: string;
    image?: ImageMetadata;
    imageAlt: string;
  };
  whatWeTest: {
    title: string;
    cards: {
      icon: ImageMetadata;
      title: string;
      description: string;
    }[];
  };
  approach: {
    title: string;
    description: string;
  };
  businessImpact: {
    title: string;
    items: {
      icon: string;
      text: string;
    }[];
  };
}

const {
  title,
  subtitle,
  description,
  heroImage,
  cta,
  challenge,
  solution,
  whatWeTest,
  approach,
  businessImpact,
} = Astro.props;
---

<Layout title={`${title} | SyslaTech`} description={description}>
  <main>
    <SolutionHero
      title={title}
      subtitle={subtitle}
      image={heroImage}
      cta={cta}
    />

    <ChallengeSolution
      challenge={challenge}
      solution={solution}
    />

    <WhatWeTest
      title={whatWeTest.title}
      cards={whatWeTest.cards}
    />

    <ApproachImpact
      approach={approach}
      businessImpact={businessImpact}
    />
  </main>
</Layout>
