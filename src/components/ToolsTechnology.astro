
---
import "../styles/tools-technology.css";
import { toolsTechnology } from "../data/ToolsTechnology.js";

const { logo, kicker, heading, highlight, description, tools } =
  toolsTechnology;
---

<section
  class="overflow-hidden bg-white px-[6%] py-[60px] text-[#081727] min-[761px]:px-[5.5%] min-[761px]:py-[90px]"
>
  <div
    class="mx-auto grid w-full max-w-[1300px] grid-cols-1 items-center gap-[45px] min-[761px]:grid-cols-[minmax(280px,0.8fr)_minmax(0,1.2fr)] min-[761px]:gap-[35px] min-[1051px]:grid-cols-[minmax(320px,0.9fr)_minmax(0,1.1fr)] min-[1051px]:gap-[70px]"
  >
    <!-- Orbit illustration -->
    <div
      class="relative mx-auto grid aspect-square w-[290px] max-w-full place-items-center min-[421px]:w-[min(100%,370px)] min-[761px]:w-[min(100%,370px)] min-[1051px]:w-[min(100%,460px)]"
    >
      <!-- Outer ring -->
      <div
        class="absolute h-[92%] w-[92%] rounded-full border border-[#dce8f3]"
      ></div>

      <!-- Inner ring -->
      <div
        class="absolute h-[70%] w-[70%] rounded-full border border-[#e8eff7]"
      ></div>

      <!-- Center logo -->
      <div
        class="relative z-[2] grid h-[86px] w-[86px] place-items-center rounded-full border border-[#e2edf7] bg-white shadow-[0_12px_35px_rgba(8,23,39,0.09)] min-[421px]:h-[100px] min-[421px]:w-[100px] min-[761px]:h-[100px] min-[761px]:w-[100px] min-[1051px]:h-[130px] min-[1051px]:w-[130px]"
      >
        <img
          src={logo.src}
          alt="Syslatech"
          class="h-[78%] w-[78%] object-contain"
        />

      </div>

      <!-- Rotating tool logos -->
      <div
        class="tools-orbit-spin absolute inset-0 motion-reduce:animate-none"
      >
        {tools.map((tool) => (
          <div
            class="absolute left-1/2 top-1/2 h-0 w-0"
            style={`--angle: ${tool.angle}deg;`}
          >
            <div
              class="tools-orbit-position absolute"
            >
              <div
                class="tools-orbit-icon absolute grid place-items-center rounded-[13px] border border-[#e3edf6] bg-white p-2 shadow-[0_8px_24px_rgba(8,23,39,0.08)] min-[421px]:h-14 min-[421px]:w-14 min-[421px]:p-[10px] min-[761px]:h-14 min-[761px]:w-14 min-[761px]:p-[10px] min-[1051px]:h-[66px] min-[1051px]:w-[66px] min-[1051px]:rounded-[18px] min-[1051px]:p-3"
              >
                <img
                  src={tool.image.src}
                  alt={tool.name}
                  class="block h-full w-full object-contain"
                />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Text content -->
    <div>
      <span
        class="inline-flex items-center gap-[10px] text-[13px] font-bold uppercase tracking-[1.3px] text-[#267bb4]"
      >
        <span
          class="h-2 w-2 shrink-0 rounded-full bg-[#3b9bd4]"
        ></span>
        {kicker}
      </span>

      <h2
        class="mt-5 text-[clamp(30px,7vw,38px)] font-bold leading-[1.2] tracking-[-1.3px] text-[#081727] min-[761px]:text-[clamp(30px,3vw,43px)]"
      >
        {heading}
        <span
          class="bg-[linear-gradient(100deg,#2088c8,#55b8dc)] bg-clip-text text-transparent"
        >
          {" "}{highlight}
        </span>
      </h2>

      <p class="mb-7 mt-5 text-[15px] leading-[1.85] text-[#607184]">
        {description}
      </p>

            <!-- Tools list -->
      <div class="flex flex-col">
        {tools.map((tool) => (
          <div
            class="group flex items-center gap-[11px] rounded-[10px] border-b border-[#e8eef4] px-[5px] py-[15px] transition-[background-color,transform] duration-[250ms] ease-in-out hover:translate-x-1 hover:bg-[#f3f9fd] min-[421px]:gap-4 min-[421px]:px-3 min-[761px]:gap-4 min-[761px]:px-3 min-[761px]:py-[17px] motion-reduce:transition-none motion-reduce:hover:translate-x-0"
          >
            <img
              class="h-[38px] w-[38px] shrink-0 rounded-[10px] border border-[#e8eef4] bg-white p-[6px] object-contain min-[421px]:h-11 min-[421px]:w-11"
              src={tool.image.src}
              alt=""
              loading="lazy"
            />
    

            <div class="min-w-0 flex-1">
              <h3 class="mb-[5px] text-[15px] font-bold text-[#10253a]">
                {tool.name}
              </h3>

              <p class="text-[12px] leading-[1.6] text-[#68798a] min-[421px]:text-[13px]">
                {tool.description}
              </p>
            </div>

            <iconify-icon
              icon="lucide:arrow-right"
              aria-hidden="true"
              class="shrink-0 text-[23px] text-[#368dc3] transition-transform duration-[250ms] group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
            ></iconify-icon>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
<script>
  import "iconify-icon";
</script>