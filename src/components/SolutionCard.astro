---
import { Image } from "astro:assets";

interface Props {
  title: string;
  subtitle: string;
  description: string;
  icon: ImageMetadata;
  href: string;
}

const { title, subtitle, description, icon, href } = Astro.props;
---

<a
  href={href}
  aria-label={`${title}: ${description}`}
  class="solution-card group relative isolate flex min-h-[180px] min-w-0 flex-col items-center justify-center overflow-hidden rounded-[12px] border border-white/35 bg-white/[0.03] px-3 py-4 text-center text-white no-underline transition-[border-color,box-shadow,transform] duration-500 ease-in-out hover:-translate-y-0.5 hover:border-transparent hover:shadow-[0_16px_35px_rgba(0,0,0,0.35),0_0_25px_rgba(94,234,212,0.35),0_0_50px_rgba(94,234,212,0.18)] focus-visible:-translate-y-0.5 focus-visible:border-transparent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white motion-reduce:transition-none
  after:pointer-events-none after:absolute after:inset-0 after:z-[2] after:rounded-[inherit] after:border-2 after:border-[rgba(94,234,212,1)] after:opacity-0 after:shadow-[0_0_12px_rgba(94,234,212,0.5),inset_0_0_8px_rgba(94,234,212,0.2)] after:transition-[opacity,box-shadow] after:duration-300 after:content-[''] hover:after:opacity-100 hover:after:shadow-[0_0_18px_rgba(94,234,212,0.9),0_0_35px_rgba(94,234,212,0.55),0_0_60px_rgba(94,234,212,0.3),inset_0_0_12px_rgba(94,234,212,0.25)] focus-visible:after:opacity-100 focus-visible:after:shadow-[0_0_12px_rgba(94,234,212,0.5),0_0_24px_rgba(94,234,212,0.2),inset_0_0_8px_rgba(94,234,212,0.12)] motion-reduce:after:transition-none"
>
  
<!-- Animated background -->
<span
  aria-hidden="true"
  class="pointer-events-none absolute inset-0 z-0 translate-y-full bg-[linear-gradient(135deg,#e5f4ff_0%,#ffffff_65%,#e0f2fe_100%)] transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-y-0 group-focus-visible:translate-y-0 motion-reduce:transition-none"
></span>


  <!-- Card content -->
  <div
    class="relative z-[1] flex w-full flex-col items-center justify-center gap-3"
  >
    <!-- Icon -->
    <div
      class="grid size-12 shrink-0 place-items-center transition-transform duration-300 group-hover:scale-95 group-focus-visible:scale-95 motion-reduce:transition-none"
    >
      <Image
        src={icon}
        alt=""
        class="block h-full w-full object-contain brightness-0 invert transition-[filter] duration-500 group-hover:brightness-100 group-hover:invert-0 group-focus-visible:brightness-100 group-focus-visible:invert-0 motion-reduce:transition-none"
        loading="lazy"
      />
    </div>

    <!-- Title -->
    <h3
      class="m-0 max-w-[230px] text-[17px] leading-[1.3] font-medium text-inherit transition-[font-size,color] duration-500 group-hover:text-[15px] group-hover:text-[#0B1B31] group-focus-visible:text-[15px] group-focus-visible:text-[#0B1B31]"
    >
      {title}
    </h3>

    <!-- Subtitle -->
    <h4
      class="m-0 max-h-0 max-w-[260px] translate-y-2 overflow-hidden text-sm leading-6 font-semibold text-[#0878D1] opacity-0 transition-[max-height,opacity,transform,margin] duration-500 ease-in-out group-hover:mt-0 group-hover:max-h-[80px] group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:mt-1 group-focus-visible:max-h-[80px] group-focus-visible:translate-y-0 group-focus-visible:opacity-100 motion-reduce:transition-none"
    >
      {subtitle}
    </h4>

    <!-- Description -->
    <p
      class="m-0 max-h-0 max-w-[280px] translate-y-2 overflow-hidden text-sm leading-[1.65] font-normal text-[#536780] opacity-0 transition-[max-height,opacity,transform,margin] duration-500 ease-in-out group-hover:mt-0 group-hover:max-h-[100px] group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:mt-1 group-focus-visible:max-h-[100px] group-focus-visible:translate-y-0 group-focus-visible:opacity-100 motion-reduce:transition-none"
    >
      {description}
    </p>

    <!-- Learn more -->
    <span
      class="mt-0 inline-flex max-h-0 translate-y-2 items-center gap-3 overflow-hidden text-sm leading-6 font-semibold text-[#0878D1] opacity-0 transition-[max-height,opacity,transform,margin] duration-500 group-hover:mt-1 group-hover:max-h-10 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:mt-2 group-focus-visible:max-h-10 group-focus-visible:translate-y-0 group-focus-visible:opacity-100 motion-reduce:transition-none"
    >
      Learn more

      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="transition-transform duration-300 group-hover:translate-x-1 group-focus-visible:translate-x-1 motion-reduce:transition-none"
      >
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </span>
  </div>
</a>
