---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  subtitle: string;
  description: string;
  icon: string;
  href: string;
}

const { title, subtitle, description, icon, href } = Astro.props;
---

<a
  href={href}
  aria-label={`${title}: ${description}`}
  class="solution-card group relative isolate flex h-[230px] min-w-0 flex-col items-center justify-center overflow-hidden rounded-[12px] border border-white/35 bg-white/[0.03] px-3 py-4 text-center text-white no-underline transition-[border-color,box-shadow] duration-300 ease-in-out hover:border-transparent hover:shadow-[0_0_25px_rgba(94,234,212,0.35),0_0_50px_rgba(94,234,212,0.18)] focus-visible:border-transparent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white motion-reduce:transition-none
  after:pointer-events-none after:absolute after:inset-0 after:z-[2] after:rounded-[inherit] after:border-2 after:border-[rgba(94,234,212,1)] after:opacity-0 after:shadow-[0_0_12px_rgba(94,234,212,0.5),inset_0_0_8px_rgba(94,234,212,0.2)] after:transition-[opacity,box-shadow] after:duration-300 after:content-[''] hover:after:opacity-100 hover:after:shadow-[0_0_18px_rgba(94,234,212,0.9),0_0_35px_rgba(94,234,212,0.55),0_0_60px_rgba(94,234,212,0.3),inset_0_0_12px_rgba(94,234,212,0.25)] focus-visible:after:opacity-100 focus-visible:after:shadow-[0_0_12px_rgba(94,234,212,0.5),0_0_24px_rgba(94,234,212,0.2),inset_0_0_8px_rgba(94,234,212,0.12)] motion-reduce:after:transition-none"
>
  <!-- Animated background -->
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 translate-y-full bg-[linear-gradient(135deg,#e5f4ff_0%,#ffffff_65%,#e0f2fe_100%)] transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-y-0 group-focus-visible:translate-y-0 motion-reduce:transition-none"
  ></span>

    <!-- Card content -->
  <div
    class="relative z-[1] flex h-full w-full flex-col items-center justify-center gap-2"
  >
    <!-- Icon: always visible and centered -->
    <div class="grid size-12 shrink-0 place-items-center">
      <Icon
        name={icon}
        aria-hidden="true"
        class="block h-full w-full text-[#0B1B31] brightness-0 invert transition-[filter] duration-300 group-hover:brightness-100 group-hover:invert-0 group-focus-visible:brightness-100 group-focus-visible:invert-0 motion-reduce:transition-none"
      />
    </div>

    <!-- Title: visible before hover -->
    <h3
      class="m-0 max-w-[230px] text-[17px] leading-6 font-medium text-white transition-opacity duration-200 group-hover:hidden group-focus-visible:hidden motion-reduce:transition-none"
    >
      {title}
    </h3>

    <!-- Subtitle: appears on hover, with consistent spacing -->
    <h4
      class="m-0 max-h-0 max-w-[260px] overflow-hidden text-sm leading-5 font-semibold text-[#0878D1] opacity-0 transition-[max-height,opacity] duration-300 group-hover:max-h-10 group-hover:opacity-100 group-focus-visible:max-h-10 group-focus-visible:opacity-100 motion-reduce:transition-none"
    >
      {subtitle}
    </h4>

    <!-- Description: appears directly below the subtitle -->
    <p
      class="m-0 max-h-0 max-w-[280px] overflow-hidden text-sm leading-5 font-normal text-[#536780] opacity-0 transition-[max-height,opacity] duration-300 group-hover:max-h-[72px] group-hover:opacity-100 group-focus-visible:max-h-[72px] group-focus-visible:opacity-100 motion-reduce:transition-none"
    >
      {description}
    </p>
  </div>
</a>