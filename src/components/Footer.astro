
---
import Logo from "../assets/Logo.svg";
import "../styles/footer.css";
import "@fortawesome/fontawesome-free/css/all.min.css";

import QuickLinks from "./QuickLinks.astro";
import ContactUs from "./ContactUs.astro";
import GetInTouch from "./GetInTouch.astro";
---

<footer class="site-footer">
  <div class="footer-container">

    <!-- Column 1: Company branding -->
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="Syslatech home">
        <img
          src={Logo.src}
          alt="Syslatech"
          class="footer-logo-image"
        />
      </a>

      <p class="footer-description">
        Quality Engineering for a Smarter Digital Future
      </p>
    </div>

    <!-- Column 2: Quick links -->
    <QuickLinks />

    <!-- Column 3: Contact details -->
    <ContactUs />

    <!-- Column 4: Small footer contact form -->
    <GetInTouch />

  </div>

  <!-- Copyright -->
  <div class="footer-bottom">
    <p>
      Copyright © 2026-27 Syslatech Private Ltd Reserved All Rights
    </p>
  </div>
</footer>
