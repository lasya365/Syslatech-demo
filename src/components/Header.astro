
---
import { menus } from "../data/HeaderMenus.js";
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
/>

<header
  class="site-header relative z-[1000] w-full font-[Manrope,sans-serif] text-[#081727] bg-gradient-to-r from-[#d4edff] to-[#f5fbff] border-b border-[#0799f5]/20 transition-[background-color,box-shadow,border-color] duration-250 ease-in-out [&_*]:box-border
  [&.is-scrolled]:fixed [&.is-scrolled]:top-0 [&.is-scrolled]:right-0 [&.is-scrolled]:left-0 [&.is-scrolled]:bg-[rgba(245,251,255,0.97)] [&.is-scrolled]:border-b-[#0799f5]/20 [&.is-scrolled]:shadow-[0_8px_28px_rgba(7,153,245,0.1)] [&.is-scrolled]:backdrop-blur-[16px]"
  data-header
>
  <div
    class="header-inner mx-auto flex min-h-[88px] w-full max-w-[1440px] items-center justify-between gap-[26px] px-[clamp(24px,4vw,64px)] max-[1180px]:gap-[14px] max-[1180px]:px-[22px] max-[900px]:relative max-[900px]:min-h-[76px] max-[900px]:flex-wrap max-[900px]:gap-0 max-[900px]:px-[22px] max-[420px]:px-4"
  >
    <!-- Logo -->
    <a
      class="brand inline-flex min-w-0 flex-[0_0_178px] items-center no-underline max-[1180px]:flex-[0_0_145px] max-[900px]:flex-[0_0_158px] max-[420px]:flex-[0_0_145px]"
      href="/"
      aria-label="Syslatech home"
    >
      <img
        class="brand-image block h-12 w-[178px] max-w-full object-contain object-left transition-[transform,filter] duration-300 ease-in-out hover:scale-105 hover:drop-shadow-[0_0_6px_rgba(7,153,245,0.3)] max-[1180px]:w-[145px] max-[900px]:h-11 max-[900px]:w-[158px] max-[420px]:w-[145px]"
        src="/images/syslatech-logo.svg"
        alt="SYSLATECH"
        width="180"
        height="52"
      />
    </a>

    <!-- Mobile menu button -->
    <button
      class="mobile-toggle hidden h-11 w-11 flex-col items-center justify-center gap-[5px] rounded-lg border border-[#081727]/30 bg-transparent p-[10px] text-[#081727] cursor-pointer focus-visible:outline-2 focus-visible:outline-[#006bb5] focus-visible:outline-offset-[3px] max-[900px]:ml-auto max-[900px]:flex"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="main-navigation"
      data-mobile-toggle
    >
      <span
        class="block h-0.5 w-5 rounded-full bg-current transition-[transform,opacity] duration-200 first:[.menu-open_&]:translate-y-[7px] first:[.menu-open_&]:rotate-45 [&:nth-child(2)]:[.menu-open_&]:opacity-0 last:[.menu-open_&]:-translate-y-[7px] last:[.menu-open_&]:-rotate-45"
      ></span>
      <span
        class="block h-0.5 w-5 rounded-full bg-current transition-[transform,opacity] duration-200 first:[.menu-open_&]:translate-y-[7px] first:[.menu-open_&]:rotate-45 [&:nth-child(2)]:[.menu-open_&]:opacity-0 last:[.menu-open_&]:-translate-y-[7px] last:[.menu-open_&]:-rotate-45"
      ></span>
      <span
        class="block h-0.5 w-5 rounded-full bg-current transition-[transform,opacity] duration-200 first:[.menu-open_&]:translate-y-[7px] first:[.menu-open_&]:rotate-45 [&:nth-child(2)]:[.menu-open_&]:opacity-0 last:[.menu-open_&]:-translate-y-[7px] last:[.menu-open_&]:-rotate-45"
      ></span>
    </button>

    <!-- Main navigation -->
    <nav
      class="main-nav flex min-w-0 flex-1 items-center justify-end gap-1 max-[900px]:absolute max-[900px]:top-full max-[900px]:right-0 max-[900px]:left-0 max-[900px]:hidden max-[900px]:max-h-[calc(100dvh-76px)] max-[900px]:flex-col max-[900px]:items-stretch max-[900px]:justify-start max-[900px]:gap-1 max-[900px]:overflow-x-hidden max-[900px]:overflow-y-auto max-[900px]:border-b max-[900px]:border-[#0799f5]/20 max-[900px]:bg-[#f5fbff] max-[900px]:px-[22px] max-[900px]:pt-[14px] max-[900px]:pb-[22px] max-[900px]:shadow-[0_22px_55px_rgba(7,153,245,0.14)] max-[420px]:px-4 [.menu-open_&]:max-[900px]:flex"
      id="main-navigation"
      aria-label="Main navigation"
      data-main-nav
    >
      {menus.map((menu) => (
        <div
          class="nav-item group/navitem relative min-[901px]:static w-auto max-[900px]:w-full"
          data-nav-item
        >
          <button
            class="nav-link dropdown-trigger relative inline-flex min-h-11 items-center justify-center gap-[7px] rounded-[7px] border-0 bg-transparent px-[11px] py-[10px] text-xs font-bold leading-normal text-inherit no-underline whitespace-nowrap cursor-pointer transition-[color,background-color] duration-200 hover:text-[#006bb5] focus-visible:outline-2 focus-visible:outline-[#006bb5] focus-visible:outline-offset-[3px] after:absolute after:right-[11px] after:bottom-[5px] after:left-[11px] after:h-0.5 after:rounded-sm after:bg-[#0799f5] after:content-[''] after:scale-x-0 after:origin-left after:transition-transform after:duration-200 hover:after:scale-x-100 [.is-open_>_&]:text-[#006bb5] [.is-open_>_&]:after:scale-x-100 max-[1180px]:gap-[5px] max-[1180px]:px-[7px] max-[1180px]:text-[11px] max-[900px]:min-h-12 max-[900px]:w-full max-[900px]:justify-between max-[900px]:px-[10px] max-[900px]:py-3 max-[900px]:text-[13px] max-[900px]:text-left max-[900px]:after:hidden max-[900px]:hover:bg-[#0799f5]/[0.09] max-[900px]:[.is-open_>_&]:bg-[#0799f5]/[0.09]"
            type="button"
            aria-expanded="false"
            aria-controls={`menu-${menu.key}`}
            data-dropdown-trigger
          >
            {menu.label}
            <i
              class="bi bi-chevron-down nav-chevron shrink-0 text-[10px] transition-transform duration-200 [.is-open_&]:rotate-180"
              aria-hidden="true"
            ></i>
          </button>

          <!-- Mega menu -->
          <div
            class={`mega-menu mega-menu-${menu.key} absolute top-[calc(100%-8px)] right-0 left-0 z-[1001] w-full border-y border-[#0799f5]/20 bg-[#f5fbff] px-[clamp(24px,4vw,64px)] pt-[38px] pb-[34px] text-[#081727] shadow-[0_22px_55px_rgba(7,153,245,0.14)] invisible opacity-0 pointer-events-none transition-[opacity,visibility] duration-[180ms] before:absolute before:-top-2 before:right-0 before:left-0 before:h-2 before:content-[''] min-[901px]:group-hover/navitem:visible min-[901px]:group-hover/navitem:opacity-100 min-[901px]:group-hover/navitem:pointer-events-auto min-[901px]:group-focus-within/navitem:visible min-[901px]:group-focus-within/navitem:opacity-100 min-[901px]:group-focus-within/navitem:pointer-events-auto [.is-open_>_&]:visible [.is-open_>_&]:opacity-100 [.is-open_>_&]:pointer-events-auto max-[1180px]:px-6 max-[900px]:static max-[900px]:hidden max-[900px]:mt-[6px] max-[900px]:max-h-none max-[900px]:overflow-visible max-[900px]:rounded-[10px] max-[900px]:border max-[900px]:border-[#0799f5]/25 max-[900px]:bg-[#f5fbff] max-[900px]:p-[14px] max-[900px]:pb-[18px] max-[900px]:opacity-100 max-[900px]:visible max-[900px]:pointer-events-auto max-[900px]:shadow-[inset_0_1px_0_rgba(7,153,245,0.04)] max-[900px]:before:hidden max-[900px]:[.is-open_>_&]:block`}
            id={`menu-${menu.key}`}
            data-mega-menu
          >
            <div
              class="mega-menu-inner mx-auto grid w-full max-w-[1280px] grid-cols-[minmax(210px,0.72fr)_minmax(0,2fr)] gap-[clamp(24px,3vw,48px)] max-[1180px]:grid-cols-[minmax(180px,0.65fr)_minmax(0,2fr)] max-[1180px]:gap-[22px] max-[900px]:block"
            >
              <!-- Dropdown introduction -->
              <div
                class="mega-intro border-r border-[#0799f5]/20 pt-[7px] pr-[25px] pb-3 max-[900px]:border-r-0 max-[900px]:px-2 max-[900px]:pt-2 max-[900px]:pb-4"
              >
                <span
                  class="mega-eyebrow mb-[14px] inline-block text-[10px] font-extrabold tracking-[0.16em] text-[#006bb5] max-[900px]:mb-2"
                >
                  {menu.eyebrow}
                </span>

                <h2
                  class="mb-3 max-w-[280px] text-[clamp(22px,2vw,29px)] leading-[1.25] font-extrabold tracking-[-0.04em] text-[#081727] max-[900px]:mb-[7px] max-[900px]:max-w-none max-[900px]:text-[21px]"
                >
                  {menu.heading}
                </h2>

                <p
                  class="mb-[21px] max-w-[310px] text-[13px] leading-[1.8] text-[#62798b] max-[900px]:mb-3 max-[900px]:max-w-none max-[900px]:text-xs"
                >
                  {menu.description}
                </p>

                <a
                  class="mega-view-all inline-flex items-center gap-[10px] text-xs font-extrabold text-[#006bb5] no-underline transition-colors duration-200 hover:text-[#081727] focus-visible:outline-2 focus-visible:outline-[#006bb5] focus-visible:outline-offset-[3px]"
                  href={menu.href}
                >
                  {menu.action}
                  <i
                    class="bi bi-arrow-up-right transition-transform duration-200 group-hover/navitem:translate-x-[3px] group-hover/navitem:-translate-y-[3px]"
                    aria-hidden="true"
                  ></i>
                </a>
              </div>

              <!-- Dropdown cards -->
              <div
                class="mega-grid grid min-w-0 grid-cols-[repeat(3,minmax(0,1fr))] content-start gap-3 max-[1180px]:grid-cols-2 max-[900px]:grid-cols-1 max-[900px]:gap-[7px] max-[900px]:px-2"
              >
                {menu.items.map((item) => (
                  <a
                    class="mega-card group/card relative flex min-h-[112px] min-w-0 items-start gap-3 rounded-[10px] border border-[#0799f5]/[0.18] bg-[#f5fbff] pt-[15px] pr-[27px] pb-[15px] pl-[14px] text-[#081727] no-underline transition-[background-color,border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:border-[#0799f5]/[0.55] hover:bg-[#e5f4ff] hover:shadow-[0_9px_22px_rgba(7,153,245,0.12)] focus-visible:outline-2 focus-visible:outline-[#006bb5] focus-visible:outline-offset-[3px] max-[900px]:min-h-[80px] max-[900px]:bg-[#f5fbff] max-[900px]:pt-3 max-[900px]:pr-[30px] max-[900px]:pb-3 max-[900px]:pl-3"
                    href={item.href || menu.href}
                    aria-label={`${item.title}: ${item.description}`}
                  >
                    <span
                      class="card-icon flex h-[39px] w-[39px] shrink-0 items-center justify-center rounded-[9px] border border-[#0799f5]/[0.22] bg-[#0799f5]/[0.09] text-[18px] text-[#006bb5] max-[900px]:h-9 max-[900px]:w-9 max-[900px]:text-base"
                      aria-hidden="true"
                    >
                      {menu.key === "tools" ? (
                        <img
                          class="tool-logo block h-[38px] w-[38px] shrink-0 object-contain"
                          src={item.logo}
                          alt=""
                          loading="lazy"
                        />
                      ) : (
                        <i class={`bi ${item.icon}`}></i>
                      )}
                    </span>

                    <span class="card-content flex min-w-0 flex-1 flex-col gap-[6px]">
                      <strong class="text-xs leading-[1.5] font-extrabold text-[#081727]">
                        {item.title}
                      </strong>

                      <small class="text-[11px] leading-[1.65] font-medium text-[#62798b]">
                        {item.description}
                      </small>
                    </span>

                    <i
                      class="bi bi-arrow-up-right card-arrow absolute top-3 right-3 text-xs text-[#62798b] transition-[color,transform] duration-200 group-hover/card:translate-x-0.5 group-hover/card:-translate-y-0.5 group-hover/card:text-[#006bb5]"
                      aria-hidden="true"
                    ></i>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}

      <!-- Blogs -->
      <a
        class="nav-link simple-link relative inline-flex min-h-11 items-center justify-center rounded-[7px] px-[11px] py-[10px] text-xs font-bold text-inherit no-underline whitespace-nowrap transition-colors duration-200 hover:text-[#006bb5] focus-visible:outline-2 focus-visible:outline-[#006bb5] focus-visible:outline-offset-[3px] after:absolute after:right-[11px] after:bottom-[5px] after:left-[11px] after:h-0.5 after:rounded-sm after:bg-[#0799f5] after:content-[''] after:scale-x-0 after:origin-left after:transition-transform after:duration-200 hover:after:scale-x-100 max-[1180px]:px-[7px] max-[1180px]:text-[11px] max-[900px]:min-h-12 max-[900px]:w-full max-[900px]:justify-start max-[900px]:px-[10px] max-[900px]:py-3 max-[900px]:text-[13px] max-[900px]:after:hidden max-[900px]:hover:bg-[#0799f5]/[0.09]"
        href="/blogs/"
      >
        Blogs
      </a>

      <!-- Contact button -->
      <a
        class="contact-button ml-[7px] inline-flex min-h-[45px] flex-none items-center justify-center gap-[10px] rounded-[7px] border border-[#0799f5] bg-[#0799f5] px-[18px] text-xs font-extrabold text-white no-underline whitespace-nowrap transition-[color,background-color,border-color,box-shadow,transform] duration-200 hover:-translate-y-px hover:border-[#006bb5] hover:bg-[#006bb5] hover:shadow-[0_6px_20px_rgba(0,107,181,0.22)] focus-visible:outline-2 focus-visible:outline-[#006bb5] focus-visible:outline-offset-[3px] [&_i]:text-sm max-[1180px]:ml-[3px] max-[1180px]:gap-[6px] max-[1180px]:px-[11px] max-[1180px]:text-[11px] max-[900px]:mt-2 max-[900px]:mr-0 max-[900px]:mb-0 max-[900px]:ml-0 max-[900px]:min-h-[46px] max-[900px]:w-full max-[900px]:text-xs"
        href="/contact/"
      >
        Contact Us
        <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
      </a>
    </nav>
  </div>
</header>

<script>
  import "../scripts/header.js";
</script>
