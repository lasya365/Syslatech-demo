---
import "../styles/Header.css";

import { menus } from "../data/HeaderMenus.js";
---

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
/>

<header class="site-header" data-header>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Syslatech home">
      <img
        class="brand-image"
        src="/images/syslatech-logo.svg"
        alt="SYSLATECH"
        width="180"
        height="52"
      />
    </a>

    <button
      class="mobile-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="main-navigation"
      data-mobile-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav
      class="main-nav"
      id="main-navigation"
      aria-label="Main navigation"
      data-main-nav
    >
      {menus.map((menu) => (
        <div class="nav-item" data-nav-item>
          <button
            class="nav-link dropdown-trigger"
            type="button"
            aria-expanded="false"
            aria-controls={`menu-${menu.key}`}
            data-dropdown-trigger
          >
            {menu.label}
            <i class="bi bi-chevron-down nav-chevron" aria-hidden="true"></i>
          </button>

          <div
            class={`mega-menu mega-menu-${menu.key}`}
            id={`menu-${menu.key}`}
            data-mega-menu
          >
            <div class="mega-menu-inner">
              <div class="mega-intro">
                <span class="mega-eyebrow">{menu.eyebrow}</span>
                <h2>{menu.heading}</h2>
                <p>{menu.description}</p>

                <a class="mega-view-all" href={menu.href}>
                  {menu.action}
                  <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                </a>
              </div>

              <div class="mega-grid">
                {menu.items.map((item) => (
                  <a
                    class="mega-card"
                    href={item.href || menu.href}
                    aria-label={`${item.title}: ${item.description}`}
                  >
                    
                    
                    <span class="card-icon" aria-hidden="true">
                      {menu.key === "tools" ? (
                        <img
                          class="tool-logo"
                          src={item.logo}
                          alt=""
                          loading="lazy"
                        />
                      ) : (
                        <i class={`bi ${item.icon}`}></i>
                      )}
                    </span>

                    <span class="card-content">
                      <strong>{item.title}</strong>
                      <small>{item.description}</small>
                    </span>

                    <i
                      class="bi bi-arrow-up-right card-arrow"
                      aria-hidden="true"
                    ></i>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}

      <a class="nav-link simple-link" href="/blogs/">Blogs</a>

      <a class="contact-button" href="/contact/">
        Contact Us
        <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
      </a>
    </nav>
  </div>
</header>

<script>
  import "../scripts/header.js";
</script>