---
import { Icon } from "astro-icon/components";
---

<div class="min-w-0 font-sans">
  <h2 class="mb-5 mt-1 text-[17px] font-bold leading-6 text-heading md:mb-[25px]">
    Quick Links
    <span class="mt-3 block h-[3px] w-9 rounded-full bg-brand-blue"></span>
  </h2>

  <ul class="m-0 flex list-none flex-col gap-3 p-0 md:gap-[14px]">
    <li>
      <a
        href="/"
        class="group inline-flex items-center gap-2.5 text-sm leading-[1.7] text-body no-underline transition-colors duration-200 hover:text-brand-blue"
      >
        <Icon
          name="lucide:chevron-right"
          class="h-3 w-3 shrink-0 text-brand-blue transition-transform duration-200 group-hover:translate-x-1"
          aria-hidden="true"
        />
        <span>Home</span>
      </a>
    </li>

    <li>
      <a
        href="/services/"
        class="group inline-flex items-center gap-2.5 text-sm leading-[1.7] text-body no-underline transition-colors duration-200 hover:text-brand-blue"
      >
        <Icon
          name="lucide:chevron-right"
          class="h-3 w-3 shrink-0 text-brand-blue transition-transform duration-200 group-hover:translate-x-1"
          aria-hidden="true"
        />
        <span>Services</span>
      </a>
    </li>

    <li>
      <a
        href="/about/"
        class="group inline-flex items-center gap-2.5 text-sm leading-[1.7] text-body no-underline transition-colors duration-200 hover:text-brand-blue"
      >
        <Icon
          name="lucide:chevron-right"
          class="h-3 w-3 shrink-0 text-brand-blue transition-transform duration-200 group-hover:translate-x-1"
          aria-hidden="true"
        />
        <span>About Us</span>
      </a>
    </li>

    <li>
      <a
        href="/contact/"
        class="group inline-flex items-center gap-2.5 text-sm leading-[1.7] text-body no-underline transition-colors duration-200 hover:text-brand-blue"
      >
        <Icon
          name="lucide:chevron-right"
          class="h-3 w-3 shrink-0 text-brand-blue transition-transform duration-200 group-hover:translate-x-1"
          aria-hidden="true"
        />
        <span>Contact Us</span>
      </a>
    </li>
  </ul>
</div>
