---
interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<article class="why-item">
  <div class="why-item__icon">
    <i class={icon} aria-hidden="true"></i>
  </div>

  <h3 class="why-item__title">{title}</h3>

  <p class="why-item__description">{description}</p>
</article>