
---
interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<article
  class="group grid grid-cols-[60px_200px_minmax(0,1fr)] items-center gap-6 rounded-lg border-b border-white/20 px-3 py-6 transition-[transform,background-color] duration-[250ms] ease-in-out hover:translate-x-1 hover:bg-white/[0.09] last:border-b-0 max-md:grid-cols-[52px_minmax(0,1fr)] max-md:gap-3 max-md:px-2 max-md:py-[22px] max-[420px]:grid-cols-[44px_minmax(0,1fr)] max-[420px]:gap-[10px] motion-reduce:transition-none motion-reduce:hover:translate-x-0"
>
  <div
    class="col-start-1 row-start-1 flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-full border border-white/28 bg-white/[0.16] text-white transition-[color,background-color,transform,box-shadow] duration-[250ms] ease-in-out group-hover:scale-110 group-hover:border-white group-hover:bg-white group-hover:text-[#159e9a] group-hover:shadow-[0_5px_16px_rgba(0,0,0,0.14)] group-focus-within:border-white group-focus-within:bg-white group-focus-within:text-[#159e9a] max-md:row-span-2 max-md:h-[46px] max-md:w-[46px] max-[420px]:h-10 max-[420px]:w-10 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
  >
    <i class={`${icon} text-[23px] leading-none max-[420px]:text-[19px]`} aria-hidden="true"></i>
  </div>

  <h3
    class="m-0 font-sans text-[18px] leading-[1.4] font-bold text-white max-md:text-[17px]"
  >
    {title}
  </h3>

  <p
    class="m-0 text-[14px] leading-[1.7] text-white/95 max-md:col-start-2 max-md:text-[13px]"
  >
    {description}
  </p>
</article>
