---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro"

interface ContentBlock {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt: string;
}

interface Props {
  challenge: ContentBlock;
  solution: ContentBlock;
}

const { challenge, solution } = Astro.props;

const blocks = [
  { ...challenge, reverse: false },
  { ...solution, reverse: true },
];
---

<section class="bg-surface px-5 py-12 sm:px-8 lg:py-16">
  <div class="mx-auto max-w-5xl space-y-12 lg:space-y-14">
    {blocks.map((block) => (
      <div
        class:list={[
          "grid items-center gap-8 lg:grid-cols-2 lg:gap-14",
          block.reverse && "lg:[&>*:first-child]:order-2",
        ]}
      >
        <div class="text-center">
          <h2 class="text-2xl font-extrabold text-heading">
            {block.title}
          </h2>

          <p class="mx-auto mt-3 max-w-md text-sm leading-7 tracking-wide text-body sm:text-base">
            {block.description}
          </p>
        </div>

        <div class="flex min-h-56 items-center justify-center">
          {block.image ? (
            <Image
               src={block.image}
               alt={block.imageAlt}
               loading="lazy"
               class="aspect-[4/3] w-full rounded-2xl object-cover"
            />
          ) : (
            <div class="flex aspect-[4/3] w-full items-center justify-center rounded-2xl border-2 border-dashed border-brand-border bg-brand-tint p-6 text-center">
              <p class="text-sm font-semibold text-muted">
                {block.title} image placeholder
              </p>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
