---
interface ImpactItem {
  icon: string;
  text: string;
}

interface Props {
  approach: {
    title: string;
    description: string;
  };
  businessImpact: {
    title: string;
    items: ImpactItem[];
  };
}

const { approach, businessImpact } = Astro.props;

---

<section class="bg-surface px-5 py-12 sm:px-8 lg:py-16">
  <div class="mx-auto max-w-5xl">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-2xl font-extrabold text-heading">
        {approach.title}
      </h2>

      <p class="mt-4 text-sm leading-7 text-body sm:text-base">
        {approach.description}
      </p>
    </div>

    <div class="mt-14">
      <h2 class="mb-5 text-center text-2xl font-extrabold text-heading">
        {businessImpact.title}
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2">
        {businessImpact.items.map((item, index) => (
          

<div
  class:list={[
    "flex min-h-24 items-center gap-4 px-5 py-5 sm:px-8",
    index % 2 === 0 && "sm:border-r sm:border-brand-border",
    index % 2 === 0 && "sm:justify-end",
    index < businessImpact.items.length - 2 &&
      "sm:border-b sm:border-brand-border",
    index < businessImpact.items.length - 1 &&
      "border-b border-brand-border sm:border-b-0",
  ]}
>
  <div class="flex w-full max-w-xs items-center gap-4">
    <img
  src={item.icon}
  alt=""
  aria-hidden="true"
  class="size-7 shrink-0"
/>

    <p class="text-base font-medium leading-6 text-heading sm:text-lg">
      {item.text}
    </p>
  </div>
</div>

        ))}
      </div>
    </div>
  </div>
</section>
