---
import { Image } from "astro:assets";
import Logo from "../../assets/Logo.svg";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  subtitle: string;
  image?: ImageMetadata;
  cta: {
    label: string;
    href: string;
  };
}

const { title, subtitle, image, cta } = Astro.props;
---

<section class="bg-page px-5 py-10 sm:px-8 lg:py-12">
  <div
    class="mx-auto grid max-w-7xl items-center gap-8 rounded-[2rem] border border-brand-blue/15 bg-surface-blue/60 px-6 py-10 sm:px-10 lg:grid-cols-2 lg:px-16 lg:py-14"
  >
    <!-- Left content -->
    <div>
      <div class="mb-8">
        <Image
          src={Logo}
          alt="Syslatech"
          width={165}
          class="h-auto w-40"
        />
      </div>

      <h1
        class="max-w-xl text-3xl font-extrabold leading-tight text-brand-navy sm:text-4xl lg:text-5xl"
      >
        {title}
      </h1>

      <p class="mt-4 max-w-xl text-base leading-7 text-body sm:text-lg">
        {subtitle}
      </p>

      <a
        href={cta.href}
        class="mt-7 inline-flex min-h-11 items-center justify-center rounded-md bg-brand-navy px-6 py-3 text-center text-sm font-bold text-white transition-colors hover:bg-brand-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue"
      >
        {cta.label}
      </a>
    </div>

    <!-- Right illustration -->
    <div class="flex min-h-64 items-center justify-center lg:min-h-80">
      {image ? (
        <Image
          src={image}
          alt="Software testing tools and technologies"
          class="max-h-96 w-full rounded-2xl object-contain"
          widths={[400, 600, 800]}
          sizes="(min-width: 1024px) 50vw, 100vw"
        />
      ) : (
        <div
          class="flex aspect-[4/3] w-full max-w-lg items-center justify-center rounded-2xl border-2 border-dashed border-brand-blue/40 bg-surface/50 p-6 text-center"
        >
          <p class="text-sm font-semibold text-muted">
            Web Testing Illustration
            <span class="mt-2 block font-normal">
              Add your illustration here
            </span>
          </p>
        </div>
      )}
    </div>
  </div>
</section>