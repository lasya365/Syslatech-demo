---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { withBase } from "../utils/withBase";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Syslatech | Quality Engineering",
  description = "Quality Engineering for a Smarter Digital Future",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
      <!-- Website favicon -->
    <link rel="icon" type="image/x-icon" href={withBase("/favicon.ico")} />

<meta
  name="description"
  content={description}
/>

<!-- Open Graph: WhatsApp, LinkedIn, Facebook, etc. -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Syslatech" />
<meta
  property="og:title"
  content="Syslatech | Quality Engineering for a Smarter Digital Future"
/>
<meta
  property="og:description"
  content="Delivering reliable software through manual testing, automation testing, and quality engineering solutions."
/>
<meta property="og:image" content="https://syslatech.com/og-image.jpg" />
<meta
  property="og:image:alt"
  content="Syslatech quality engineering and software testing banner"
/>
<meta property="og:url" content="https://syslatech.com/" />

<!-- X / Twitter preview -->
<meta name="twitter:card" content="summary_large_image" />
<meta
  name="twitter:title"
  content="Syslatech | Quality Engineering"
/>
<meta
  name="twitter:description"
  content="Reliable software through quality engineering and testing."
/>
<meta
  name="twitter:image"
  content="https://syslatech.com/og-image.jpg"
/>

    <title>{title}</title>

    <!-- Establish early connections for Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <!-- Allow pages to add page-specific metadata and resources -->
    <slot name="head" />
  </head>

  <body>
    <Header />

    <slot />

    <Footer />
  </body>
</html>